# Copy to .env for local development.
# Never commit .env or reuse production credentials for tests.
# Values below are empty or synthetic placeholders.

# Required database connection.
# For destructive local scripts, use a disposable database whose name
# ends in _test, _ci, _demo or _benchmark.
# Remote databases are refused by seed:demo and qa:pipeline.
DATABASE_URL=""

# Optional direct connection used by db:push.
# For destructive scripts, it must target the same local database.
DATABASE_URL_UNPOOLED=""

# Login: comma-separated emails permitted to sign in.
ALLOWED_EMAILS="developer@example.test"

# Generate a separate secret for each environment:
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional AI providers; leave empty for offline/synthetic testing.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional provider model overrides.
CLAUDE_MODEL=""
OPENAI_MODEL=""
GEMINI_MODEL=""

# Cron authentication and application cache refresh.
# Use the URL and secret belonging to this environment only.
CRON_SECRET=""
APP_URL=""

# Optional external data services.
API_FOOTBALL_KEY=""
THESPORTSDB_API_KEY=""

# Optional Telegram notifications; leave empty during local tests.
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# Test-only endpoint overrides: leave unset for normal application use.
# FOOTBALL_DATA_BASE_URL=
# ANTHROPIC_BASE_URL=

# QA credentials belong to disposable test environments only.
# QA_BASE_URL=http://127.0.0.1:3104
# QA_EMAIL=qa@example.test
# QA_PASSWORD=
# QA_RUN_CRON=0

# NODE_ENV and VERCEL_ENV are supplied by the runtime/platform.
# QA_ALLOW_REMOTE_DB is no longer an override for destructive scripts.
